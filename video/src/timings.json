  "sentences": [
    {
      "scene": "problem",
      "start": 0.0,
      "end": 2.7,
      "clip": null,
      "text": "You stream your AI agent."
    },
    {
      "scene": "problem",
      "start": 2.7,
      "end": 5.4,
      "clip": null,
      "text": "Everyone watching sees your screen."
    },
    {
      "scene": "problem",
      "start": 5.4,
      "end": 9.3,
      "clip": null,
      "text": "One tool call can flash an API key."
    },
    {
      "scene": "problem",
      "start": 9.3,
      "end": 12.6,
      "clip": null,
      "text": "A wallet key. Or an email."
    },
    {
      "scene": "idea",
      "start": 12.6,
      "end": 16.5,
      "clip": null,
      "text": "What if they saw a second, clean screen?"
    },
    {
      "scene": "idea",
      "start": 16.5,
      "end": 19.6,
      "clip": null,
      "text": "Stageglass is a Hermes Agent plugin."
    },
    {
      "scene": "idea",
      "start": 19.6,
      "end": 24.0,
      "clip": null,
      "text": "A one-way glass between you and your viewers."
    },
    {
      "scene": "how",
      "start": 24.0,
      "end": 26.7,
      "clip": null,
      "text": "It hooks into Hermes itself."
    },
    {
      "scene": "how",
      "start": 26.7,
      "end": 30.6,
      "clip": null,
      "text": "Every message, tool call, and approval passes through."
    },
    {
      "scene": "how",
      "start": 30.6,
      "end": 35.7,
      "clip": null,
      "text": "Keys, tokens, seed phrases, and emails are redacted before the audience."
    },
    {
      "scene": "how",
      "start": 35.7,
      "end": 38.8,
      "clip": null,
      "text": "A known key turns into [REDACTED]."
    },
    {
      "scene": "how",
      "start": 38.8,
      "end": 42.6,
      "clip": null,
      "text": "Not sure? The feed goes to HOLD."
    },
    {
      "scene": "use",
      "start": 42.6,
      "end": 45.0,
      "clip": null,
      "text": "Install Stageglass from GitHub."
    },
    {
      "scene": "use",
      "start": 45.0,
      "end": 47.4,
      "clip": "onair",
      "text": "Type /onair on."
    },
    {
      "scene": "use",
      "start": 47.4,
      "end": 49.8,
      "clip": null,
      "text": "Open http://127.0.0.1:8765."
    },
    {
      "scene": "use",
      "start": 49.8,
      "end": 54.1,
      "clip": null,
      "text": "Or add that link as an OBS Browser Source."
    },
    {
      "scene": "use",
      "start": 54.1,
      "end": 57.2,
      "clip": null,
      "text": "Share that window, not the terminal."
    },
    {
      "scene": "use",
      "start": 57.2,
      "end": 60.0,
      "clip": null,
      "text": "/onair hold pauses. /onair off stops."
    },
    {
      "scene": "proof",
      "start": 60.0,
      "end": 63.1,
      "clip": "key",
      "text": "Here is a real Hermes session."
    },
    {
      "scene": "proof",
      "start": 63.1,
      "end": 66.6,
      "clip": "key",
      "text": "The fake key stays on your screen."
    },
    {
      "scene": "proof",
      "start": 66.6,
      "end": 69.3,
      "clip": "key",
      "text": "The audience copy sees [REDACTED]."
    },
    {
      "scene": "proof",
      "start": 69.3,
      "end": 73.2,
      "clip": "tool",
      "text": "The tool name updates as the agent works."
    },
    {
      "scene": "proof",
      "start": 73.2,
      "end": 77.4,
      "clip": "hold",
      "text": "A private key sends the feed to HOLD."
    },
    {
      "scene": "end",
      "start": 77.4,
      "end": 79.8,
      "clip": null,
      "text": "Stageglass."
    },
    {
      "scene": "end",
      "start": 79.8,
      "end": 82.2,
      "clip": null,
      "text": "Go live without leaking."
    },
    {
      "scene": "end",
      "start": 82.2,
      "end": 85.8,
      "clip": null,
      "text": "github.com/Benito3262/stageglass"
    },
    {
      "scene": "end",
      "start": 85.8,
