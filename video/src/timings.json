  "sentences": [
    {
      "scene": "problem",
      "start": 0.0,
      "end": 2.7,
      "clip": null,
      "text": "You stream your AI agent."
    },
    {
      "scene": "problem",
      "start": 2.7,
      "end": 5.4,
      "clip": null,
      "text": "Everyone watching sees your screen."
    },
    {
      "scene": "problem",
      "start": 5.4,
      "end": 9.3,
      "clip": null,
      "text": "One tool call can flash an API key."
    },
    {
      "scene": "problem",
      "start": 9.3,
      "end": 12.95,
      "clip": null,
      "text": "A wallet key. Or an email."
    },
    {
      "scene": "idea",
      "start": 12.95,
      "end": 16.85,
      "clip": null,
      "text": "What if they saw a second, clean screen?"
    },
    {
      "scene": "idea",
      "start": 16.85,
      "end": 19.95,
      "clip": null,
      "text": "Stageglass is a Hermes Agent plugin."
    },
    {
      "scene": "idea",
      "start": 19.95,
      "end": 24.4,
      "clip": null,
      "text": "A one-way glass between you and your viewers."
    },
    {
      "scene": "how",
      "start": 24.4,
      "end": 27.1,
      "clip": null,
      "text": "It hooks into Hermes itself."
    },
    {
      "scene": "how",
      "start": 27.1,
      "end": 31.0,
      "clip": null,
      "text": "Every message, tool call, and approval passes through."
    },
    {
      "scene": "how",
      "start": 31.0,
      "end": 36.1,
      "clip": null,
      "text": "Keys, tokens, seed phrases, and emails are redacted before the audience."
    },
    {
      "scene": "how",
      "start": 36.1,
      "end": 39.2,
      "clip": null,
      "text": "A known key turns into [REDACTED]."
    },
    {
      "scene": "how",
      "start": 39.2,
      "end": 43.25,
      "clip": null,
      "text": "Not sure? The feed goes to HOLD."
    },
    {
      "scene": "use",
      "start": 43.25,
      "end": 45.55,
      "clip": null,
      "text": "Install Stageglass from GitHub."
    },
    {
      "scene": "use",
      "start": 45.55,
      "end": 47.05,
      "clip": "onair",
      "text": "Type /onair on."
    },
    {
      "scene": "use",
      "start": 47.05,
      "end": 48.55,
      "clip": null,
      "text": "Open http://127.0.0.1:8765."
    },
    {
      "scene": "use",
      "start": 48.55,
      "end": 52.85,
      "clip": null,
      "text": "Or add that link as an OBS Browser Source."
    },
    {
      "scene": "use",
      "start": 52.85,
      "end": 55.95,
      "clip": null,
      "text": "Share that window, not the terminal."
    },
    {
      "scene": "use",
      "start": 55.95,
      "end": 58.8,
      "clip": null,
      "text": "/onair hold pauses. /onair off stops."
    },
    {
      "scene": "proof",
      "start": 58.8,
      "end": 61.9,
      "clip": "key",
      "text": "Here is a real Hermes session."
    },
    {
      "scene": "proof",
      "start": 61.9,
      "end": 65.4,
      "clip": "key",
      "text": "The fake key stays on your screen."
    },
    {
      "scene": "proof",
      "start": 65.4,
      "end": 68.1,
      "clip": "key",
      "text": "The audience copy sees [REDACTED]."
    },
    {
      "scene": "proof",
      "start": 68.1,
      "end": 72.0,
      "clip": "tool",
      "text": "The tool name updates as the agent works."
    },
    {
      "scene": "proof",
      "start": 72.0,
      "end": 76.45,
      "clip": "hold",
      "text": "A private key sends the feed to HOLD."
    },
    {
      "scene": "end",
      "start": 76.45,
      "end": 77.55,
      "clip": null,
      "text": "Stageglass."
    },
    {
      "scene": "end",
      "start": 77.55,
      "end": 79.85,
      "clip": null,
      "text": "Go live without leaking."
    },
    {
      "scene": "end",
      "start": 79.85,
      "end": 82.25,
      "clip": null,
      "text": "github.com/Benito3262/stageglass"
    },
    {
      "scene": "end",
      "start": 82.25,
      "end": 85.2,
      "clip": null,
      "text": "benito3262.github.io/stageglass"
    }
