  "sentences": [
    {
      "scene": "problem",
      "start": 0.0,
      "end": 2.4,
      "clip": null,
      "text": "You stream your AI agent."
    },
    {
      "scene": "problem",
      "start": 2.4,
      "end": 4.8,
      "clip": null,
      "text": "Everyone watching sees your screen."
    },
    {
      "scene": "problem",
      "start": 4.8,
      "end": 8.4,
      "clip": null,
      "text": "One tool call can flash an API key."
    },
    {
      "scene": "problem",
      "start": 8.4,
      "end": 10.8,
      "clip": null,
      "text": "A wallet key. Or an email."
    },
    {
      "scene": "idea",
      "start": 10.8,
      "end": 14.4,
      "clip": null,
      "text": "What if they saw a second, clean screen?"
    },
    {
      "scene": "idea",
      "start": 14.4,
      "end": 16.8,
      "clip": null,
      "text": "Stageglass is a Hermes Agent plugin."
    },
    {
      "scene": "idea",
      "start": 16.8,
      "end": 20.4,
      "clip": null,
      "text": "A one-way glass between you and your viewers."
    },
    {
      "scene": "how",
      "start": 20.4,
      "end": 22.8,
      "clip": null,
      "text": "It hooks into Hermes itself."
    },
    {
      "scene": "how",
      "start": 22.8,
      "end": 26.4,
      "clip": null,
      "text": "Every message, tool call, and approval passes through."
    },
    {
      "scene": "how",
      "start": 26.4,
      "end": 31.2,
      "clip": null,
      "text": "Keys, tokens, seed phrases, and emails are redacted before the audience."
    },
    {
      "scene": "how",
      "start": 31.2,
      "end": 33.6,
      "clip": null,
      "text": "A known key turns into [REDACTED]."
    },
    {
      "scene": "how",
      "start": 33.6,
      "end": 36.6,
      "clip": null,
      "text": "Not sure? The feed goes to HOLD."
    },
    {
      "scene": "use",
      "start": 36.6,
      "end": 39.0,
      "clip": null,
      "text": "Install Stageglass from GitHub."
    },
    {
      "scene": "use",
      "start": 39.0,
      "end": 41.4,
      "clip": "onair",
      "text": "Type /onair on."
    },
    {
      "scene": "use",
      "start": 41.4,
      "end": 43.8,
      "clip": null,
      "text": "Open http://127.0.0.1:8765."
    },
    {
      "scene": "use",
      "start": 43.8,
      "end": 47.4,
      "clip": null,
      "text": "Or add that link as an OBS Browser Source."
    },
    {
      "scene": "use",
      "start": 47.4,
      "end": 49.8,
      "clip": null,
      "text": "Share that window, not the terminal."
    },
    {
      "scene": "use",
      "start": 49.8,
      "end": 52.2,
      "clip": null,
      "text": "/onair hold pauses. /onair off stops."
    },
    {
      "scene": "proof",
      "start": 52.2,
      "end": 54.6,
      "clip": "key",
      "text": "Here is a real Hermes session."
    },
    {
      "scene": "proof",
      "start": 54.6,
      "end": 57.6,
      "clip": "key",
      "text": "The fake key stays on your screen."
    },
    {
      "scene": "proof",
      "start": 57.6,
      "end": 60.0,
      "clip": "key",
      "text": "The audience copy says [REDACTED]."
    },
    {
      "scene": "proof",
      "start": 60.0,
      "end": 63.6,
      "clip": "tool",
      "text": "The tool name updates as the agent works."
    },
    {
      "scene": "proof",
      "start": 63.6,
      "end": 67.2,
      "clip": "hold",
      "text": "A private key sends the feed to HOLD."
    },
    {
      "scene": "end",
      "start": 67.2,
      "end": 69.6,
      "clip": null,
      "text": "Stageglass."
    },
    {
      "scene": "end",
      "start": 69.6,
      "end": 72.0,
      "clip": null,
      "text": "Go live without leaking."
    },
    {
      "scene": "end",
      "start": 72.0,
      "end": 75.6,
      "clip": null,
      "text": "github.com/Benito3262/stageglass"
    },
    {
      "scene": "end",
